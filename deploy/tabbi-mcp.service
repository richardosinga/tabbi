[Unit]
Description=Tabbi MCP HTTP server
After=network.target

[Service]
User=tabi
Group=tabi
WorkingDirectory=/home/tabi/tabbi
EnvironmentFile=/home/tabi/tabbi/.env
ExecStart=/home/tabi/tabbi/venv/bin/python tools/mcp_server.py --http 8002
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
